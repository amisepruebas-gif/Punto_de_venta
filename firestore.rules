rules_version = '2';

// ============================================================
// ⚠️  REGLAS ABIERTAS (DESARROLLO)
// ============================================================
// Lectura y escritura sin restricciones a TODA la base de datos.
//
// Pendiente de re-aplicar antes de pasar a producción:
//   docs/13-rules-pendientes-produccion.md
//
// Razón temporal: hay apps legacy (Android, web-panel viejo, etc.) que
// usan colecciones de raíz (ventas_n, mensajes_n, datos, corte_1,
// articulos_n, apartados, /negocios/{nid}/...) y que no se pueden
// adaptar todavía. Las reglas duras de Fases 1–3 chocaban con su
// modelo de auth.
//
// Cuando se haga el corte para producción, ver el MD para reinstalar
// las reglas de Fase 1, 2 y 3 (aislamiento entre sucursales, idempotencia,
// decremento atómico de stock, restricciones de update por rol, etc.).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
