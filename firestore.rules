rules_version = '2';
// ============================================================
// CANDIDATA (NO DESPLEGADA) — cierre de las reglas del POS.
// Basada en docs/13 + correcciones del mapa + BARRIDO DE COMPLETITUD (9 gaps
// hallados y parchados: categorias, subcategorias, resurtidos-mercancia,
// chat_directos, negocio/sucursal onboarding, whitelist, colaboradores, system,
// ingresos_mercancia). Ver docs/auditoria-cashback/05 y 08.
//
// ALCANCE (corregido tras auditoría exhaustiva, ver docs/auditoria-cashback/10):
// Se CIERRA el árbol moderno `negocios_web_new_version/**` + `system` (datos VIVOS del POS
// web: ventas, clientes, stock, chat). La RAÍZ legacy (colecciones sin sufijo) se DEJA
// ABIERTA como hoy: la usan GOMU chat Electron v1/v2 y apps nativas Android que acceden
// SIN autenticación (v1 literalmente no usa Firebase Auth). Cerrar la raíz exige migrar
// esas apps primero — proyecto aparte. El objetivo de AHORA: proteger lo vivo (moderno)
// sin romper el legacy.
// Claims: role (nodo|admin|superadmin|mercancia|colaborador|enlace), negocioId, sucursalId, nodoId,
//   colaboradorId. OJO: superadmin NO trae negocioId (por eso esAdmin lo incluye aparte).
//   Rol `enlace` (teléfono que entra por una URL, ver functions canjearEnlaceLote): trae
//   enlaceId, tipo (armar|recibir|imprimir|precio), gen, vence (ms) y, según el tipo, letra o
//   resurtidoId. `imprimir` es la PC del programa "AMISE Impresora" (sucursalId opcional).
//   `precio` es la página aparte de etiquetas de precio (código + precio, como "codigos").
//   NO es `miembro`: solo puede lo que diga una regla con `esEnlace`.
//   Rol `encargado` (encargado de tienda: usuario de mercancia-web con acceso «existencias»,
//   ver functions loginMercanciaConPin): trae negocioId, sucursalId y mercanciaUid. Solo LEE
//   el catálogo y los movimientos de su tienda. NO escribe nada: sus existencias las mueve
//   la function moverExistencias. Tampoco es `miembro`.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function rol() { return request.auth.token.role; }
    function enNegocio(nid) { return authed() && request.auth.token.negocioId == nid; }
    function esSuperAdmin() { return authed() && rol() == 'superadmin'; }
    function esAdmin(nid) { return esSuperAdmin() || (enNegocio(nid) && rol() == 'admin'); }
    function esNodo(nid) { return enNegocio(nid) && rol() == 'nodo'; }
    function esNodoSuc(nid, sid) { return esNodo(nid) && request.auth.token.sucursalId == sid; }
    function esMercancia(nid) { return enNegocio(nid) && rol() == 'mercancia'; }
    function miembro(nid) { return esAdmin(nid) || esNodo(nid) || esMercancia(nid) || esSuperAdmin(); }
    // Para ESCRIBIR no basta el rol del token (se puso al entrar con el PIN y
    // un token se renueva solo): se lee EN VIVO el registro de la persona. Si
    // admin la deshabilita o la pasa a «encargado de tienda», deja de poder
    // escribir al instante aunque su sesión siga abierta. El id de la sesión
    // es el id de su registro (functions loginMercanciaConPin).
    function mercanciaVigente(nid) {
      let u = get(/databases/$(database)/documents/negocios_web_new_version/$(nid)/sucursales_data_web_new_version/$(request.auth.token.sucursalId)/usuariosMercancia_web_new_version/$(request.auth.uid)).data;
      return u.habilitado == true && u.get('acceso', 'completo') == 'completo';
    }
    function esMercanciaEscribe(nid) { return esMercancia(nid) && mercanciaVigente(nid); }
    function esEncargado(nid) { return enNegocio(nid) && rol() == 'encargado'; }
    function esEncargadoSuc(nid, sid) { return esEncargado(nid) && request.auth.token.sucursalId == sid; }

    // Sesión de un enlace de lote. El vencimiento viene en el token (lo pone la
    // function con la hora del servidor). El apagador y la renovación se leen EN
    // VIVO del doc del enlace: apagarlo corta al instante aunque el token siga vivo.
    function enlaceVivo(nid) {
      let e = get(/databases/$(database)/documents/negocios_web_new_version/$(nid)/enlaces_lote_web_new_version/$(request.auth.token.enlaceId)).data;
      return e.activo == true && e.gen == request.auth.token.gen;
    }
    function esEnlace(nid, tipo) {
      return enNegocio(nid) && rol() == 'enlace' && request.auth.token.tipo == tipo
        && request.time.toMillis() < request.auth.token.vence
        && enlaceVivo(nid);
    }
    function resurtidoDe(nid, rid) {
      return get(/databases/$(database)/documents/negocios_web_new_version/$(nid)/resurtidos_web_new_version/$(rid)).data;
    }

    // Kill-switch global de relogin (raíz). admin-web lo suscribe en el ARRANQUE, ANTES
    // de autenticar (main.tsx:64, enforceAuthEpoch().finally → onSnapshot). Un kill-switch
    // debe leerse sin sesión (es cuando fuerzas el logout); su valor es un string no
    // sensible. Por eso read público; write solo consola/CF (Admin SDK). G8.
    match /system/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /negocios_web_new_version/{nid} {
      // Onboarding: mercancia-web/FirstRun lista negocios+sucursales ANTES del login
      // (sin auth). Exponer SOLO el doc negocio + sucursales (info de bajo valor).
      // G5. Endurecer a futuro portando FirstRun a una CF (como nodo-web).
      allow read: if true;
      allow write: if esAdmin(nid);

      match /sucursales_web_new_version/{sid} {
        allow read: if true; // G5 onboarding
        allow write: if esAdmin(nid);
      }

      // Los crea la CF (Admin SDK). La caja lee su propio doc (para saber si
      // tiene terminal Clip) y admin solo asigna la terminal (`clipSerial`).
      match /nodos_web_new_version/{nodoId} {
        allow read: if esAdmin(nid)
          || (esNodo(nid) && request.auth.token.nodoId == nodoId);
        allow update: if esAdmin(nid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clipSerial'])
          && (!('clipSerial' in request.resource.data)
              || (request.resource.data.clipSerial is string
                  && request.resource.data.clipSerial.matches('^[A-Za-z0-9_-]{4,40}$')));
      }

      // Códigos de alta de cajas (solo su hash): solo las CF (Admin SDK).
      match /codigos_caja_web_new_version/{codigoHash} {
        allow read, write: if false;
      }

      // Candado de cada terminal Clip (una venta a la vez): solo las CF.
      match /clip_terminales_web_new_version/{serie} {
        allow read, write: if false;
      }

      // Artículos: el nodo SOLO ajusta stock; mercancia CRUD de los normales;
      // admin full. El encargado de tienda solo los lee.
      // Los «Solo mayoreo» se registran y editan solo en admin (su precio
      // sale de la escalera de categorías): mercancía no los crea, no los
      // borra, no convierte uno normal en uno de mayoreo ni al revés, y de
      // los que existen solo toca las llaves de existencias (ingreso y
      // resurtidos).
      // Límite conocido: `subvariaciones` es una lista y aquí no se puede
      // comparar por dentro. Quien puede mover existencias (la caja y
      // mercancía) puede reescribir esa lista completa: nombre, foto y
      // promoción de cada variación incluidos. El precio del artículo
      // (`precioVenta`/`precioMenudeo`) sí queda protegido.
      match /articulos_n_web_new_version/{artId} {
        // Igual que las apps (`!!soloMayoreo`): cuenta cualquier valor
        // "verdadero", no solo `true`. Si no, un `soloMayoreo: "si"` pasaría
        // aquí por artículo normal y la caja de mayoreo lo vendería.
        function deMayoreo(d) {
          let v = d.get('soloMayoreo', false);
          return !(v == false || v == null || v == '' || v == 0);
        }
        function soloExistencias() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cantidad', 'subvariaciones', 'cantidadBodega', 'cantidadPorSucursal',
                      'cantidadBodegaSucursal']);
        }
        allow read: if miembro(nid) || esEncargado(nid);
        // Enlace de armar: la lista de los fabricados (`where fabricado == true`)
        // y, por su código, otro artículo solo si tiene piezas en el taller (lo
        // único que se puede enviar en un lote). Así no se puede recorrer el
        // catálogo por id (los ids son consecutivos). `resource == null`: puede
        // preguntar por un código que no existe.
        allow get: if esEnlace(nid, 'armar')
          && (resource == null
              || resource.data.get('fabricado', false) == true
              || int(resource.data.get('cantidadBodega', '0')) > 0);
        allow list: if esEnlace(nid, 'armar') && resource.data.fabricado == true;
        allow create: if esAdmin(nid)
          || (esMercanciaEscribe(nid) && !deMayoreo(request.resource.data));
        // `resource == null`: borrar uno que ya no existe (doble toque en
        // «Eliminar») no es un error de permiso.
        allow delete: if esAdmin(nid)
          || (esMercanciaEscribe(nid) && (resource == null || !deMayoreo(resource.data)));
        allow update: if esAdmin(nid)
          || (esMercanciaEscribe(nid)
              && ((!deMayoreo(resource.data) && !deMayoreo(request.resource.data))
                  || soloExistencias()))
          || (esNodo(nid) && soloExistencias());
      }

      // G1/G2: categorías y subcategorías (mercancia + admin).
      match /categorias_web_new_version/{cid} {
        allow read: if miembro(nid) || esEncargado(nid);
        allow write: if esAdmin(nid) || esMercanciaEscribe(nid);
      }
      match /subcategorias_web_new_version/{scid} {
        allow read: if miembro(nid) || esEncargado(nid);
        allow write: if esAdmin(nid) || esMercanciaEscribe(nid);
      }
      // Géneros (temáticas: Anime, K-pop…): mismo trato que categorías. La
      // caja los lee para sus filtros.
      match /generos_web_new_version/{gid} {
        allow read: if miembro(nid) || esEncargado(nid);
        allow write: if esAdmin(nid) || esMercanciaEscribe(nid);
      }

      // datos: config (admin), huellas *_ac (nodo), tallas (mercancia).
      // El folio de Fabricacion (_contadorFabricacion) y el contador de etiquetas
      // de lote (_contadorEtiquetasLote) solo los avanza admin. Los precios de
      // mayoreo por categoría y subcategoría (_preciosMayoreo) solo los escribe
      // admin: de ahí sale el precio de los artículos «Solo mayoreo».
      match /datos_web_new_version/{k} {
        allow read: if miembro(nid);
        allow write: if esAdmin(nid)
          || ((esNodo(nid) || esMercanciaEscribe(nid))
              && k != '_contadorFabricacion' && k != '_contadorEtiquetasLote'
              && k != '_preciosMayoreo');
        // El programa de una impresora (acceso `imprimir`) aparta números de
        // etiquetas de lote al tomar una orden: sube el contador (de a lo más
        // 300) SOLO junto con esa orden. En la misma escritura la orden
        // `trabajoId` pasa de pendiente a imprimiendo, tomada por esta PC, y
        // su `hasta` es el nuevo `ultimo`. Sin orden no lo puede mover, y la
        // regla de la cola exige que el contador traiga su id: dos órdenes no
        // pueden llevarse el mismo rango.
        function contadorDeSuOrden() {
          let tid = request.resource.data.trabajoId;
          let ruta = /databases/$(database)/documents/negocios_web_new_version/$(nid)/impresiones_web_new_version/$(tid);
          return get(ruta).data.estado == 'pendiente'
            && getAfter(ruta).data.estado == 'imprimiendo'
            && getAfter(ruta).data.impresoraId == request.auth.token.enlaceId
            && getAfter(ruta).data.tomadoPor == request.auth.uid
            && getAfter(ruta).data.hasta == request.resource.data.ultimo;
        }
        allow get: if k == '_contadorEtiquetasLote' && esEnlace(nid, 'imprimir');
        allow create: if k == '_contadorEtiquetasLote' && esEnlace(nid, 'imprimir')
          && request.resource.data.keys().hasOnly(['ultimo', 'trabajoId'])
          && request.resource.data.ultimo is int
          && request.resource.data.ultimo >= 1 && request.resource.data.ultimo <= 300
          && request.resource.data.trabajoId is string
          && contadorDeSuOrden();
        allow update: if k == '_contadorEtiquetasLote' && esEnlace(nid, 'imprimir')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo', 'trabajoId'])
          && request.resource.data.ultimo is int
          && request.resource.data.ultimo > resource.data.ultimo
          && request.resource.data.ultimo - resource.data.ultimo <= 300
          && request.resource.data.trabajoId is string
          && contadorDeSuOrden();
      }

      // Resurtidos y LOTES de envío (un lote es un resurtido con `cajas`).
      //  - Resurtido simple: admin y mercancia lo crean y despachan (G3); la caja
      //    solo recibe y cierra los de SU sucursal (los campos que hoy toca).
      //  - Lote: lo arma un enlace (solo el suyo y solo mientras se arma), admin
      //    confirma el envío y declara "no llegó", y la caja de su sucursal solo
      //    agrega sesiones de recepción.
      match /resurtidos_web_new_version/{rid} {
        function esLote(d) { return 'cajas' in d; }
        function cambia() { return request.resource.data.diff(resource.data).affectedKeys(); }
        function sesiones(d) { return d.get('recepcion', {}).get('sesiones', {}); }
        function soloAgregaSesiones() {
          let d = sesiones(request.resource.data).diff(sesiones(resource.data));
          return d.removedKeys().size() == 0 && d.changedKeys().size() == 0;
        }
        function mio() { return resource.data.enlaceId == request.auth.token.enlaceId; }
        function armandose(d) { return d.estado == 'creando' && d.get('listo', false) == false; }
        // Lo que un enlace puede dejar escrito en un lote suyo. Las cantidades de
        // adentro NO se pueden revisar aquí: admin las vuelve a validar al enviar.
        function loteDeEnlace(d) {
          return d.estado == 'creando' && d.enlaceId == request.auth.token.enlaceId
            && d.cajas is map && d.cajas.size() <= 50
            && d.get('paquetes', {}) is map && d.get('paquetes', {}).size() <= 999
            && d.get('sueltas', {}) is map && d.get('sueltas', {}).size() <= 999
            && d.lineas is list && d.lineas.size() == 0
            && !('recepcion' in d);
        }

        allow read: if miembro(nid);
        // El enlace solo ve sus lotes. `resource == null`: puede preguntar si un
        // código de lote está libre antes de crearlo.
        allow get: if esEnlace(nid, 'armar') && (resource == null || mio());
        allow list: if esEnlace(nid, 'armar') && mio();

        allow create: if esAdmin(nid)
          || (esMercanciaEscribe(nid) && !esLote(request.resource.data))
          || (esEnlace(nid, 'armar') && loteDeEnlace(request.resource.data)
              && request.resource.data.creadoPorUid == request.auth.uid
              && request.resource.data.folio == rid
              && rid.matches('^L[0-9]{6}-' + request.auth.token.letra + '[0-9]{1,3}$'));

        // Un lote ya enviado no se borra.
        allow delete: if (esAdmin(nid) && (!esLote(resource.data) || resource.data.estado == 'creando'))
          || (esMercanciaEscribe(nid) && !esLote(resource.data))
          || (esEnlace(nid, 'armar') && mio() && armandose(resource.data));

        allow update: if
          // Candado para TODOS (admin incluido): un lote sigue siendo lote, no
          // cambia de identidad, nunca usa los estados del flujo viejo, sus
          // sesiones solo se agregan y, una vez enviado, nunca vuelve a armarse
          // y su lista ya no cambia. Mientras se arma solo puede pasar a enviado.
          (!esLote(resource.data)
            || (esLote(request.resource.data)
                && !cambia().hasAny(['id', 'folio', 'enlaceId', 'creadoPorUid', 'fechaCreacion'])
                && soloAgregaSesiones()
                && (resource.data.estado == 'creando'
                    ? request.resource.data.estado in ['creando', 'enviado']
                    : (request.resource.data.estado in ['enviado', 'parcial', 'cerrado']
                       && !cambia().hasAny(['cajas', 'paquetes', 'sueltas', 'lineas',
                                            'sucursalDestinoId', 'sucursalDestinoNombre'])))))
          && (
            esAdmin(nid)
            || (esMercanciaEscribe(nid) && !esLote(resource.data) && !esLote(request.resource.data))
            // La caja: solo lo de su sucursal, y solo recibir. En un lote, UNA
            // sesión nueva por escritura. Uno cerrado sigue cerrado: todavía
            // recibe lo que aparezca después de "no llegó".
            || (esNodoSuc(nid, resource.data.sucursalDestinoId)
                && (esLote(resource.data)
                    ? (resource.data.estado in ['enviado', 'parcial', 'cerrado']
                       && request.resource.data.estado
                            in (resource.data.estado == 'cerrado' ? ['cerrado'] : ['parcial', 'cerrado'])
                       && sesiones(request.resource.data).size() == sesiones(resource.data).size() + 1
                       && cambia().hasOnly(['estado', 'recepcion', 'fechaRecibido', 'fechaCerrado',
                                            'responsableRecibe']))
                    : (resource.data.estado in ['en_transito', 'recibido']
                       && request.resource.data.estado in ['recibido', 'cerrado']
                       && !esLote(request.resource.data)
                       && cambia().hasOnly(['estado', 'lineas', 'fechaRecibido', 'fechaCerrado',
                                            'responsableRecibe', 'responsableConfirma']))))
            // El enlace: solo su lote y solo mientras se arma.
            || (esEnlace(nid, 'armar') && mio() && armandose(resource.data)
                && loteDeEnlace(request.resource.data)
                && cambia().hasOnly(['cajas', 'paquetes', 'sueltas', 'sucursalDestinoId',
                                     'sucursalDestinoNombre', 'responsableEmpaco', 'notas',
                                     'paqueteria', 'guias', 'listo', 'fechaListo']))
          );

        // Fotos del lote: las sube un enlace de fotos, solo las de SU lote y
        // hasta 30 por teléfono (el id es `{uid}_{00..29}`). No se editan.
        match /fotos_web_new_version/{fid} {
          allow read: if miembro(nid);
          allow delete: if esAdmin(nid);
          allow create: if esEnlace(nid, 'recibir') && rid == request.auth.token.resurtidoId
            && fid.matches('^' + request.auth.uid + '_[0-2][0-9]$')
            && request.resource.data.keys().hasOnly(['ruta', 'subidoPor', 'creadoEn', 'nota'])
            && request.resource.data.ruta in [
                 'lotes_media_web_new_version/' + nid + '/' + rid + '/' + fid + '.webp',
                 'lotes_media_web_new_version/' + nid + '/' + rid + '/' + fid + '.jpg']
            && request.resource.data.subidoPor == request.auth.uid
            && request.resource.data.creadoEn == request.time
            && (!('nota' in request.resource.data)
                || (request.resource.data.nota is string && request.resource.data.nota.size() <= 300));
        }
      }

      // Accesos por URL (enlaces de lote). Los crea admin; la caja solo crea de
      // fotos, para un lote ya enviado de su sucursal, y solo puede apagarlos. El
      // vencimiento NO se escribe aquí: lo pone la function al canjear, contando
      // desde `creadoEn`, que debe ser la hora del servidor.
      match /enlaces_lote_web_new_version/{eid} {
        function cambiaSolo(campos) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
        }
        allow read, delete: if esAdmin(nid);
        allow create: if (esAdmin(nid) || esNodo(nid))
          && request.resource.data.keys().hasOnly(['tipo', 'activo', 'nombre', 'letra', 'secretoHash',
                                                   'gen', 'creadoPor', 'creadoEn', 'sucursalId', 'resurtidoId'])
          && request.resource.data.tipo in ['armar', 'recibir', 'imprimir', 'precio']
          && request.resource.data.activo == true
          && request.resource.data.gen == 0
          && request.resource.data.secretoHash is string
          && request.resource.data.secretoHash.matches('^[0-9a-f]{64}$')
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.creadoEn == request.time
          && (esAdmin(nid)
              || (request.resource.data.tipo == 'recibir'
                  && request.resource.data.sucursalId == request.auth.token.sucursalId
                  && resurtidoDe(nid, request.resource.data.resurtidoId).sucursalDestinoId == request.auth.token.sucursalId
                  && resurtidoDe(nid, request.resource.data.resurtidoId).estado in ['enviado', 'parcial', 'cerrado']));
        allow update: if
          // Admin: apagar/prender, renombrar y renovar (secreto nuevo, gen + 1).
          (esAdmin(nid) && cambiaSolo(['activo', 'nombre', 'secretoHash', 'gen', 'canjes']))
          || (esNodo(nid) && resource.data.creadoPor == request.auth.uid
              && cambiaSolo(['activo']) && request.resource.data.activo == false);
      }

      // Etiquetas numeradas ya usadas (id = código): una etiqueta, un lote. No se
      // editan; solo admin las libera.
      match /etiquetas_lote_web_new_version/{codigo} {
        // El enlace solo aparta una etiqueta ya impresa (hasta el contador que
        // avanza admin al generar el PDF), para un lote suyo que se está armando
        // y que la usa como caja o paquete en esta misma escritura.
        function etiquetaParaSuLote(rid) {
          let antes = resurtidoDe(nid, rid);
          let despues = getAfter(/databases/$(database)/documents/negocios_web_new_version/$(nid)/resurtidos_web_new_version/$(rid)).data;
          let contador = get(/databases/$(database)/documents/negocios_web_new_version/$(nid)/datos_web_new_version/_contadorEtiquetasLote).data;
          return antes.enlaceId == request.auth.token.enlaceId
            && antes.estado == 'creando' && antes.get('listo', false) == false
            && int(codigo) <= 880000000000 + contador.ultimo
            && (('c' + codigo) in despues.cajas || ('p' + codigo) in despues.get('paquetes', {}));
        }
        allow get: if miembro(nid) || esEnlace(nid, 'armar');
        allow list, delete: if esAdmin(nid);
        allow create: if codigo.matches('^88[0-9]{10}$')
          && request.resource.data.keys().hasOnly(['resurtidoId', 'enlaceId', 'creadoEn'])
          && request.resource.data.creadoEn == request.time
          && (esAdmin(nid)
              || (esEnlace(nid, 'armar')
                  && request.resource.data.enlaceId == request.auth.token.enlaceId
                  && etiquetaParaSuLote(request.resource.data.resurtidoId)));
      }

      // Impresoras de etiquetas: una por PC con el programa "AMISE Impresora";
      // el id es el de su acceso `imprimir`. Las ven las apps del negocio, el
      // teléfono de armar y la página de etiquetas de precio (para elegir
      // dónde imprimir). Admin las crea y
      // renombra; el programa solo escribe su aviso de vida (`latidoEn`, hora
      // del servidor), la impresora de Windows, la pausa y su versión.
      match /impresoras_web_new_version/{iid} {
        function cambiaImpresora() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        allow read: if miembro(nid) || esEnlace(nid, 'armar') || esEnlace(nid, 'precio')
          || (esEnlace(nid, 'imprimir') && iid == request.auth.token.enlaceId);
        allow create: if esAdmin(nid)
          && request.resource.data.keys().hasOnly(['nombre', 'sucursalId', 'creadoEn'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 60
          && (!('sucursalId' in request.resource.data) || request.resource.data.sucursalId is string);
        allow delete: if esAdmin(nid);
        allow update: if (esAdmin(nid) && cambiaImpresora().hasOnly(['nombre', 'sucursalId']))
          || (esEnlace(nid, 'imprimir') && iid == request.auth.token.enlaceId
              && cambiaImpresora().hasOnly(['latidoEn', 'windows', 'pausada', 'version'])
              && (!cambiaImpresora().hasAny(['latidoEn'])
                  || request.resource.data.latidoEn == request.time)
              && (!('windows' in request.resource.data)
                  || (request.resource.data.windows is string
                      && request.resource.data.windows.size() <= 120))
              && (!('pausada' in request.resource.data) || request.resource.data.pausada is bool)
              && (!('version' in request.resource.data)
                  || (request.resource.data.version is string
                      && request.resource.data.version.size() <= 20)));
      }

      // Cola de impresión de etiquetas (ver shared/src/impresion.ts).
      //  - La crean: el teléfono de armar (etiquetas de lote, hasta 60), admin
      //    (etiquetas de lote, hasta 300), la caja (etiquetas de precio, a la
      //    impresora de SU sucursal) y la página de etiquetas de precio (UN
      //    código de 8 dígitos con su precio, hasta 100 piezas). Siempre a una
      //    impresora con su acceso prendido y siempre "pendiente".
      //  - Solo el programa de esa impresora la toma y la termina. Al tomar una
      //    de etiquetas de lote aparta sus números EN LA MISMA ESCRITURA en que
      //    sube el contador (getAfter): no hay números repetidos ni sueltos.
      //  - "Reimprimir": quien la mandó (o admin) la regresa a la cola; conserva
      //    sus números.
      match /impresiones_web_new_version/{tid} {
        function rutaImpresora(iid) {
          return /databases/$(database)/documents/negocios_web_new_version/$(nid)/impresoras_web_new_version/$(iid);
        }
        function rutaAcceso(iid) {
          return /databases/$(database)/documents/negocios_web_new_version/$(nid)/enlaces_lote_web_new_version/$(iid);
        }
        function rutaContador() {
          return /databases/$(database)/documents/negocios_web_new_version/$(nid)/datos_web_new_version/_contadorEtiquetasLote;
        }
        function nueva() { return request.resource.data; }
        function cambiaTrabajo() { return request.resource.data.diff(resource.data).affectedKeys(); }
        // La impresora existe y su acceso `imprimir` está prendido.
        function impresoraPrendida(iid) {
          return exists(rutaImpresora(iid))
            && get(rutaAcceso(iid)).data.tipo == 'imprimir'
            && get(rutaAcceso(iid)).data.activo == true;
        }
        function nuevaValida(campos) {
          return nueva().keys().hasOnly(campos)
            && nueva().estado == 'pendiente'
            && nueva().creadoPor == request.auth.uid
            && nueva().creadoEn == request.time
            && nueva().impresoraId is string
            && (!('quien' in nueva()) || (nueva().quien is string && nueva().quien.size() <= 80))
            && impresoraPrendida(nueva().impresoraId);
        }
        function cantidadHasta(n) {
          return nueva().cantidad is int && nueva().cantidad >= 1 && nueva().cantidad <= n;
        }
        // El renglón de la página de etiquetas de precio: código de 8 dígitos,
        // precio (como RE_PRECIO_ETIQUETA) y de 1 a 100 piezas. Nada más.
        function renglonPrecioValido(r) {
          return r is map && r.keys().hasOnly(['codigo', 'precio', 'piezas'])
            && r.codigo is string && r.codigo.matches('^[0-9]{8}$')
            && r.precio is string && r.precio.matches('^[0-9]{1,7}([.][0-9]{1,2})?$')
            && r.piezas is int && r.piezas >= 1 && r.piezas <= 100;
        }
        // Los números que aparta el programa: tantos como pide la orden, justo
        // después de lo que marcaba el contador, y el contador queda en `hasta`
        // con el id de ESTA orden (una sola orden por escritura: dos no se
        // pueden llevar el mismo rango).
        function rangoApartado() {
          return nueva().desde is int && nueva().hasta is int
            && nueva().hasta - nueva().desde + 1 == resource.data.cantidad
            && getAfter(rutaContador()).data.ultimo == nueva().hasta
            && getAfter(rutaContador()).data.get('trabajoId', '') == tid
            && (exists(rutaContador())
                ? get(rutaContador()).data.ultimo == nueva().desde - 1
                : nueva().desde == 1);
        }
        function esElPrograma() {
          return esEnlace(nid, 'imprimir') && resource.data.impresoraId == request.auth.token.enlaceId;
        }

        // `resource == null`: el teléfono y la caja pueden preguntar por una
        // orden que aún no existe (al reintentar saben si ya quedó), y el
        // programa por una que admin acaba de borrar (no es "apagada").
        allow read: if esAdmin(nid)
          || ((esEnlace(nid, 'armar') || esEnlace(nid, 'precio'))
              && (resource == null || resource.data.enlaceId == request.auth.token.enlaceId))
          || (esNodo(nid)
              && (resource == null || resource.data.sucursalId == request.auth.token.sucursalId))
          || (esEnlace(nid, 'imprimir')
              && (resource == null || resource.data.impresoraId == request.auth.token.enlaceId));

        allow create: if
          (esAdmin(nid)
            && nuevaValida(['tipo', 'impresoraId', 'estado', 'origen', 'creadoPor', 'quien', 'creadoEn',
                            'cantidad'])
            && nueva().tipo == 'etiquetas_lote' && nueva().origen == 'admin' && cantidadHasta(300))
          // Admin: etiquetas de precio de artículos finales (mayoreo), a
          // cualquier impresora del negocio.
          || (esAdmin(nid)
            && nuevaValida(['tipo', 'impresoraId', 'estado', 'origen', 'creadoPor', 'quien', 'creadoEn',
                            'renglones'])
            && nueva().tipo == 'etiquetas_precio' && nueva().origen == 'admin'
            && nueva().renglones is list
            && nueva().renglones.size() >= 1 && nueva().renglones.size() <= 20)
          || (esEnlace(nid, 'armar')
            && nuevaValida(['tipo', 'impresoraId', 'estado', 'origen', 'creadoPor', 'quien', 'creadoEn',
                            'cantidad', 'enlaceId'])
            && nueva().tipo == 'etiquetas_lote' && nueva().origen == 'enlace' && cantidadHasta(60)
            && nueva().enlaceId == request.auth.token.enlaceId)
          || (esNodo(nid)
            && nuevaValida(['tipo', 'impresoraId', 'estado', 'origen', 'creadoPor', 'quien', 'creadoEn',
                            'renglones', 'nodoId', 'sucursalId'])
            && nueva().tipo == 'etiquetas_precio' && nueva().origen == 'nodo'
            && nueva().nodoId == request.auth.token.nodoId
            && nueva().sucursalId == request.auth.token.sucursalId
            && get(rutaImpresora(nueva().impresoraId)).data.get('sucursalId', '') == request.auth.token.sucursalId
            && nueva().renglones is list
            && nueva().renglones.size() >= 1 && nueva().renglones.size() <= 20)
          || (esEnlace(nid, 'precio')
            && nuevaValida(['tipo', 'impresoraId', 'estado', 'origen', 'creadoPor', 'quien', 'creadoEn',
                            'renglones', 'enlaceId'])
            && nueva().tipo == 'etiquetas_precio' && nueva().origen == 'enlace'
            && nueva().enlaceId == request.auth.token.enlaceId
            && nueva().renglones is list && nueva().renglones.size() == 1
            && renglonPrecioValido(nueva().renglones[0]));

        allow update: if
          // El programa de esa impresora.
          (esElPrograma()
            && cambiaTrabajo().hasOnly(['estado', 'desde', 'hasta', 'tomadoPor', 'tomadoEn', 'terminadoEn',
                                        'error', 'impresiones'])
            && (
              // Tomarla. Una de etiquetas de lote sin números los aparta aquí.
              (resource.data.estado == 'pendiente' && nueva().estado == 'imprimiendo'
                && nueva().tomadoPor == request.auth.uid && nueva().tomadoEn == request.time
                && (resource.data.tipo != 'etiquetas_lote' || 'desde' in resource.data
                    ? !cambiaTrabajo().hasAny(['desde', 'hasta'])
                    : rangoApartado()))
              // Terminarla: impresa (cuenta una vez más) o con error.
              || (resource.data.estado == 'imprimiendo' && resource.data.tomadoPor == request.auth.uid
                && nueva().estado in ['impreso', 'error']
                && !cambiaTrabajo().hasAny(['desde', 'hasta', 'tomadoPor', 'tomadoEn'])
                && nueva().terminadoEn == request.time
                && (nueva().estado == 'impreso'
                    ? nueva().impresiones == resource.data.get('impresiones', 0) + 1
                    : nueva().error is string && nueva().error.size() <= 300))
              // Una orden que ni se puede intentar (mal formada).
              || (resource.data.estado == 'pendiente' && nueva().estado == 'error'
                && cambiaTrabajo().hasOnly(['estado', 'error', 'terminadoEn'])
                && nueva().terminadoEn == request.time
                && nueva().error is string && nueva().error.size() <= 300)
            ))
          // "Reimprimir": quien la mandó (o admin) la regresa a la cola, sin su
          // error, si su impresora sigue existiendo y prendida (si no, se
          // quedaría en la cola para siempre).
          || ((esAdmin(nid)
                || ((esEnlace(nid, 'armar') || esEnlace(nid, 'precio'))
                    && resource.data.enlaceId == request.auth.token.enlaceId)
                || (esNodo(nid) && resource.data.sucursalId == request.auth.token.sucursalId))
              && resource.data.estado in ['impreso', 'error'] && nueva().estado == 'pendiente'
              && cambiaTrabajo().hasOnly(['estado', 'error']) && !('error' in nueva())
              && impresoraPrendida(resource.data.impresoraId))
          // Admin cancela una que espera en la cola (p. ej. al borrar su
          // impresora) o libera una que se quedó "imprimiendo" (la PC se apagó
          // y se renovó su acceso): queda con error y se puede reimprimir.
          || (esAdmin(nid) && resource.data.estado in ['pendiente', 'imprimiendo']
              && nueva().estado == 'error'
              && cambiaTrabajo().hasOnly(['estado', 'error']) && nueva().error is string);

        allow delete: if esAdmin(nid);
      }

      // Fabricacion: zonas de precios (las leen los editores; solo admin escribe).
      match /zonas_precio_web_new_version/{zid} {
        allow read: if miembro(nid);
        allow write: if esAdmin(nid);
      }

      // Cashback de mayoreo (propio, sin amise). La config (doc `config`) la
      // lee la caja y la escribe admin. Cuentas y movimientos: solo los
      // escribe el servidor (callables); admin los lee. El PIN y el QR
      // (privado/), los índices de tarjeta y QR, las sesiones de la página y
      // los intentos de PIN: nadie desde las apps.
      match /cashback_mayoreo_web_new_version/{doc} {
        allow read: if miembro(nid);
        allow write: if esAdmin(nid);
      }
      match /clientes_mayoreo_web_new_version/{tel} {
        allow read: if esAdmin(nid);
        allow write: if false;
        match /movimientos/{mid} {
          allow read: if esAdmin(nid);
          allow write: if false;
        }
        match /privado/{d} {
          allow read, write: if false;
        }
      }
      match /tarjetas_mayoreo_web_new_version/{codigo} {
        allow read, write: if false;
      }
      match /qr_mayoreo_web_new_version/{token} {
        allow read, write: if false;
      }
      match /cashback_sesiones_web_new_version/{s} {
        allow read, write: if false;
      }
      match /cashback_intentos_web_new_version/{k} {
        allow read, write: if false;
      }
      // Fabricacion: lotes de produccion y reducciones con motivo. Inmutables
      // (sin update/delete): un error se corrige con otro registro.
      match /produccion_web_new_version/{loteId} {
        allow read, create: if esAdmin(nid);
      }
      match /ajustes_inventario_web_new_version/{ajusteId} {
        allow read, create: if esAdmin(nid);
      }

      // G9: log de auditoría de ingreso de mercancía (best-effort).
      match /ingresos_mercancia_web_new_version/{id} {
        allow read: if esAdmin(nid);
        allow create: if esAdmin(nid) || esMercanciaEscribe(nid);
      }

      // G6/G7: whitelist de delegados + colaboradores (lo escribe la CF).
      match /chat_whitelist_admin_web_new_version/{k} {
        allow read: if esAdmin(nid);
        allow write: if false;
      }
      match /colaboradores_web_new_version/{cid} {
        allow read: if esAdmin(nid);
        allow write: if false;
      }

      // Chat de grupo (nodo + admin).
      match /chat_grupos_web_new_version/{gid} {
        allow read, write: if esNodo(nid) || esAdmin(nid);
        match /dias/{ymd} { allow read, write: if esNodo(nid) || esAdmin(nid); }
      }
      match /chat_typing_web_new_version/{cid} {
        allow read, write: if esNodo(nid) || esAdmin(nid);
      }
      // G4: chat directo admin↔colaborador.
      match /chat_directos_web_new_version/{pairId} {
        allow read, write: if esAdmin(nid);
        match /dias/{ymd} { allow read, write: if esAdmin(nid); }
      }

      match /sucursales_data_web_new_version/{sid} {
        match /ventas_n_web_new_version/{vpath=**} {
          allow read: if esNodoSuc(nid, sid) || esAdmin(nid);
          allow write: if esNodoSuc(nid, sid);
        }
        match /corte_1_web_new_version/{cpath=**} {
          allow read: if esNodoSuc(nid, sid) || esAdmin(nid);
          allow write: if esNodoSuc(nid, sid);
        }
        match /apartados_web_new_version/{apId} {
          allow read: if esNodoSuc(nid, sid) || esAdmin(nid);
          allow write: if esNodoSuc(nid, sid);
        }
        match /contadores_web_new_version/{ymd} {
          allow read: if esNodoSuc(nid, sid) || esAdmin(nid);
          allow write: if esNodoSuc(nid, sid);
        }
        match /usuariosMercancia_web_new_version/{uid} {
          allow read: if esAdmin(nid);
          // Cada persona (mercancía o encargado) lee SOLO su registro: la app
          // lo vigila para sacarla en cuanto admin la deshabilita o le cambia
          // el acceso. El de los demás no: trae la huella del PIN, y un PIN
          // de 5 dígitos se saca de su huella probando los 100,000. Tampoco
          // se listan.
          allow get: if request.auth.uid == uid
            && (esEncargadoSuc(nid, sid)
                || (esMercancia(nid) && request.auth.token.sucursalId == sid));
          allow write: if esAdmin(nid);
        }
        match /mercanciaRateLimit/{doc} {
          allow read, write: if false; // solo la CF (Admin SDK)
        }
        // Movimientos de piezas entre la bodega y la tienda de esta sucursal.
        // Los escribe solo la CF moverExistencias (Admin SDK). Los ven admin y
        // la gente de mercancía de ESTA sucursal (encargado o usuario completo).
        match /movimientos_existencias_web_new_version/{mid} {
          allow read: if esAdmin(nid) || esEncargadoSuc(nid, sid)
            || (esMercancia(nid) && request.auth.token.sucursalId == sid);
          allow write: if false;
        }
        // Envíos de «Mover» que quedaron sin respuesta y la CF anuló (ya no
        // se pueden aplicar). Solo los usa moverExistencias.
        match /movimientos_anulados_web_new_version/{mid} {
          allow read, write: if false;
        }
        // Cobros con la terminal Clip: los escriben solo las CF; la caja lee
        // los suyos para seguir el cobro en vivo.
        match /pagos_clip_web_new_version/{cobroId} {
          allow read: if esAdmin(nid)
            || (esNodoSuc(nid, sid)
                && (resource == null || resource.data.nodoId == request.auth.token.nodoId));
          allow write: if false;
        }
      }
    }

    // collectionGroup items — reportes admin + nodo-web (useVentasMes).
    match /{path=**}/items/{itemId} {
      allow read: if esSuperAdmin()
        || (authed() && resource != null
            && request.auth.token.negocioId == resource.data.negocioId
            && (rol() == 'admin' || rol() == 'superadmin'
                || (rol() == 'nodo' && request.auth.token.sucursalId == resource.data.sucursalId)));
    }

    // RAÍZ legacy (GOMU chat Electron v1/v2, apps nativas Android): se DEJA ABIERTA
    // como HOY. Motivo (auditoría, docs/10): esas superficies acceden a la raíz SIN
    // autenticación — GOMU v1 no usa Firebase Auth SDK; v2 lee permisos_electron anónimo;
    // las nativas escriben dispositivos/* anónimo por FCM. Exigir authed() las rompería.
    // Cerrar la raíz de verdad exige migrar/retirar esas apps antes (proyecto aparte).
    // El catch-all EXCLUYE el árbol moderno para no defraudar sus reglas por rol
    // (Firestore combina allows con OR; un catch-all abierto sobre el moderno lo abriría).
    match /{col}/{rest=**} {
      allow read, write: if col != 'negocios_web_new_version' && col != 'system';
    }
  }
}
