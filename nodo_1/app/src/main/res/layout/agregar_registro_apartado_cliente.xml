<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout11"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/consAgregarClientePedido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/borde_blanco"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <ScrollView
            android:id="@+id/scrollView3"
            android:layout_width="284dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/blanco_mas_red"
            android:elevation="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteBusqedaAgrgarCliente"
                    android:layout_width="270dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/blanco_muy_red"
                    android:elevation="3dp"
                    android:ems="10"
                    android:hint="id"
                    android:inputType="textPersonName"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textColorHint="@color/gris_claro"
                    android:textStyle="italic"
                    app:layout_constraintStart_toStartOf="@+id/textView112"
                    app:layout_constraintTop_toBottomOf="@+id/editTextFecha" />

                <Button
                    android:id="@+id/butagregarPedido"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/colortransparente"
                    android:onClick="onClick"
                    android:text="continuar"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView133" />

                <Button
                    android:id="@+id/butArtNoReg_Agr_reg_Ap"
                    android:layout_width="0dp"
                    android:layout_height="41dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/blanco"
                    android:elevation="3sp"
                    android:fontFamily="@font/abeezee"
                    android:onClick="onClick"
                    android:padding="5dp"
                    android:paddingStart="5dp"
                    android:paddingLeft="5dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="5dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="5dp"
                    android:text="  Articulo no registrado  "
                    android:textColor="@color/gris_oscuro"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="@+id/autoCompleteBusqedaAgrgarCliente"
                    app:layout_constraintStart_toStartOf="@+id/autoCompleteBusqedaAgrgarCliente"
                    app:layout_constraintTop_toBottomOf="@+id/autoCompleteBusqedaAgrgarCliente" />

                <EditText
                    android:id="@+id/editTextNombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/borde_blanco"
                    android:ems="10"
                    android:hint="nombre"
                    android:inputType="textPersonName"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    app:layout_constraintBottom_toBottomOf="@+id/textView110"
                    app:layout_constraintStart_toEndOf="@+id/textView110"
                    app:layout_constraintTop_toTopOf="@+id/textView110" />

                <EditText
                    android:id="@+id/editTextNumeroContacto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/borde_blanco"
                    android:ems="10"
                    android:hint="#"
                    android:inputType="number"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    app:layout_constraintBottom_toBottomOf="@+id/textView111"
                    app:layout_constraintEnd_toEndOf="@+id/editTextNombre"
                    app:layout_constraintStart_toEndOf="@+id/textView111"
                    app:layout_constraintTop_toTopOf="@+id/textView111" />

                <EditText
                    android:id="@+id/editTextTotal"
                    android:layout_width="59dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/borde_blanco"
                    android:ems="10"
                    android:hint="00.00"
                    android:inputType="textPersonName"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    app:layout_constraintBottom_toBottomOf="@+id/textView136"
                    app:layout_constraintStart_toStartOf="@+id/mitadAnticipo"
                    app:layout_constraintTop_toTopOf="@+id/textView136" />

                <EditText
                    android:id="@+id/editTextAnticipoGeneral"
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/borde_blanco"
                    android:ems="10"
                    android:hint="00.00"
                    android:inputType="number"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    app:layout_constraintStart_toEndOf="@+id/textView134"
                    app:layout_constraintTop_toBottomOf="@+id/textView67" />

                <Spinner
                    android:id="@+id/spinnerDiasPlazo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:dropDownHeight="500dp"
                    app:layout_constraintBottom_toBottomOf="@+id/butPlazoPedido"
                    app:layout_constraintStart_toEndOf="@+id/butPlazoPedido"
                    app:layout_constraintTop_toTopOf="@+id/butPlazoPedido" />

                <TextView
                    android:id="@+id/textView110"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="24dp"
                    android:text="Nombre"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/butPlazoPedido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:elevation="3sp"
                    android:fontFamily="@font/abeezee"
                    android:onClick="onClick"
                    android:text="Plazo"
                    android:textColor="@color/grey_500"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="@+id/editTextTotal"
                    app:layout_constraintStart_toEndOf="@+id/editTextTotal"
                    app:layout_constraintTop_toTopOf="@+id/editTextTotal" />

                <TextView
                    android:id="@+id/editTextFecha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/borde_blanco"
                    android:ems="10"
                    android:hint="fecha inicio"
                    android:inputType="textPersonName"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    app:layout_constraintBottom_toBottomOf="@+id/textView112"
                    app:layout_constraintEnd_toEndOf="@+id/editTextNombre"
                    app:layout_constraintStart_toEndOf="@+id/textView112"
                    app:layout_constraintTop_toTopOf="@+id/textView112" />

                <TextView
                    android:id="@+id/editTextFechaTermina_"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/borde_blanco"
                    android:ems="10"
                    android:hint="fecha termina"
                    android:inputType="textPersonName"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    app:layout_constraintBottom_toBottomOf="@+id/textView98"
                    app:layout_constraintStart_toStartOf="@+id/mitadAnticipo"
                    app:layout_constraintTop_toTopOf="@+id/textView98" />

                <TextView
                    android:id="@+id/mitadAnticipo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/borde_blanco"
                    android:ems="10"
                    android:hint="00.00"
                    android:inputType="textPersonName"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    app:layout_constraintEnd_toEndOf="@+id/editTextAnticipoGeneral"
                    app:layout_constraintStart_toEndOf="@+id/textView134"
                    app:layout_constraintTop_toTopOf="@+id/textView67" />

                <TextView
                    android:id="@+id/textView111"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:text="Numero de contacto"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView110" />

                <TextView
                    android:id="@+id/textView112"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:text="Fecha"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView111" />

                <TextView
                    android:id="@+id/textView128"
                    android:layout_width="0dp"
                    android:layout_height="0.5sp"
                    android:background="@color/gris_oscuro"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toTopOf="@+id/autoCompleteBusqedaAgrgarCliente"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/editTextFecha" />

                <TextView
                    android:id="@+id/textView144"
                    android:layout_width="0dp"
                    android:layout_height="0.5sp"
                    android:layout_marginTop="12dp"
                    android:background="@color/gris_oscuro"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/butArtNoReg_Agr_reg_Ap" />

                <TextView
                    android:id="@+id/textView133"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anticipo"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@+id/textView134"
                    app:layout_constraintStart_toStartOf="@+id/textView67"
                    app:layout_constraintTop_toTopOf="@+id/textView134"
                    app:layout_constraintVertical_bias="1.0" />

                <TextView
                    android:id="@+id/textView67"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="%50 Neto"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="@+id/textView112"
                    app:layout_constraintTop_toBottomOf="@+id/textViewDevolucionAp" />

                <TextView
                    android:id="@+id/textViewTotalRestaAp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Total"
                    app:layout_constraintStart_toStartOf="@+id/textView67"
                    app:layout_constraintTop_toBottomOf="@+id/consPagosEditAP" />

                <TextView
                    android:id="@+id/textView98"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Termina"
                    app:layout_constraintStart_toStartOf="@+id/textViewTotalRestaAp"
                    app:layout_constraintTop_toBottomOf="@+id/textView136" />

                <TextView
                    android:id="@+id/textViewDevolucionAp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="8dp"
                    android:padding="1dp"
                    android:text="Devolución de $99"
                    android:textColor="@color/negro"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/textViewTotalRestaAp"
                    app:layout_constraintTop_toBottomOf="@+id/textView98" />

                <TextView
                    android:id="@+id/textView136"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$"
                    app:layout_constraintBottom_toBottomOf="@+id/textViewTotalRestaAp"
                    app:layout_constraintStart_toStartOf="@+id/textView70"
                    app:layout_constraintTop_toTopOf="@+id/textViewTotalRestaAp" />

                <TextView
                    android:id="@+id/textView134"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$"
                    app:layout_constraintStart_toStartOf="@+id/textView70"
                    app:layout_constraintTop_toTopOf="@+id/editTextAnticipoGeneral" />

                <TextView
                    android:id="@+id/textView70"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="$"
                    app:layout_constraintStart_toEndOf="@+id/textView67"
                    app:layout_constraintTop_toTopOf="@+id/mitadAnticipo" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/consPagosEditAP"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView144">

                    <TextView
                        android:id="@+id/textView153"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/abeezee"
                        android:text="Total inicial:"
                        android:textColor="@color/gris_oscuro"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView114" />

                    <TextView
                        android:id="@+id/textView155"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/abeezee"
                        android:text="$"
                        android:textColor="@color/gris_oscuro"
                        app:layout_constraintStart_toEndOf="@+id/textView153"
                        app:layout_constraintTop_toBottomOf="@+id/textView114" />

                    <TextView
                        android:id="@+id/textTotalInicialEditRegAp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/abeezee"
                        android:text="99"
                        android:textColor="@color/negro"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@+id/textView155"
                        app:layout_constraintTop_toBottomOf="@+id/textView114" />

                    <TextView
                        android:id="@+id/textView114"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/abeezee"
                        android:text="Historial de pagos"
                        android:textColor="@color/azulverde"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView159"
                        android:layout_width="0dp"
                        android:layout_height="0.5sp"
                        android:background="@color/gris_oscuro"
                        android:fontFamily="@font/abeezee"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/reyclerHistPagEditarReg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="5dp"
                        app:layout_constraintBottom_toTopOf="@+id/textView159"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView153" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerConsultarExistencia"
            android:layout_width="455dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/scrollView3"
            app:layout_constraintTop_toTopOf="@+id/scrollView3" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/consAgregueUnArticulo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/scrollView3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/scrollView3"
            app:layout_constraintTop_toTopOf="@+id/scrollView3"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textView575"
                android:layout_width="225dp"
                android:layout_height="233dp"
                android:alpha=".6"
                android:background="@drawable/canasta"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.72" />

            <TextView
                android:id="@+id/textView576"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTRO VACIO"
                android:textSize="24sp"
                android:textStyle="italic"
                app:layout_constraintBottom_toTopOf="@+id/textView575"
                app:layout_constraintEnd_toEndOf="@+id/textView575"
                app:layout_constraintStart_toStartOf="@+id/textView575"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.52" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>