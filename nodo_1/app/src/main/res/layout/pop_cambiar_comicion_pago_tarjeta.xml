<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_oscuro">

    <Button
        android:id="@+id/button35"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:background="@color/azulDatosSegmento"
        android:text="GUARDAR"
        android:textColor="@color/blanco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button34"
        app:layout_constraintVertical_bias="0.69" />

    <Button
        android:id="@+id/button36"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:background="@color/naranja_fuerte"
        android:text="usar recomendada"
        android:textColor="@color/blanco"
        app:layout_constraintBottom_toTopOf="@+id/button35"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button34"
        app:layout_constraintVertical_bias="0.69" />

    <EditText
        android:id="@+id/button34"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/blanco"
        android:hint="....."
        android:textColor="@color/blanco"
        android:textColorHint="@color/blanco"
        android:textStyle="bold"
        android:inputType="numberDecimal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>