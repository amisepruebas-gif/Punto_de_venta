<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cons"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <Button
        android:id="@+id/butAgregarNomRegCorte"
        android:layout_width="210dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@color/azulverde"
        android:fontFamily="@font/abeezee"
        android:text="agregar"
        android:textColor="@color/blanco"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/editTextPopAgregarnomCorte"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />

    <Button
        android:id="@+id/finalizarNomagregarCorte"
        android:layout_width="210dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:background="@color/azulDatosSegmento"
        android:fontFamily="@font/abeezee"
        android:text="finalizar"
        android:textColor="@color/blanco"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/editTextPopAgregarnomCorte"
        app:layout_constraintTop_toBottomOf="@+id/butAgregarNomRegCorte"
        app:layout_constraintVertical_bias="0.0" />

    <AutoCompleteTextView
        android:id="@+id/editTextPopAgregarnomCorte"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/azulDatosSegmento"
        android:ems="10"
        android:hint=".."
        android:inputType="text"
        android:paddingLeft="12dp"
        android:paddingRight="36dp"
        android:textColor="@color/blanco"
        android:textColorHint="@color/blanco"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.100000024" />

    <Button
        android:id="@+id/x_borrarCampoPopVarVenta2"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/x_blanca"
        app:layout_constraintBottom_toBottomOf="@+id/editTextPopAgregarnomCorte"
        app:layout_constraintEnd_toEndOf="@+id/editTextPopAgregarnomCorte"
        app:layout_constraintTop_toTopOf="@+id/editTextPopAgregarnomCorte" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRegNomEditarCorte"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/editTextPopAgregarnomCorte"
        app:layout_constraintStart_toStartOf="@+id/editTextPopAgregarnomCorte"
        app:layout_constraintTop_toBottomOf="@+id/editTextPopAgregarnomCorte" />
</androidx.constraintlayout.widget.ConstraintLayout>